[Unit]
Description=Atrium multiplayer WebSocket backend
After=network.target
Wants=network.target

[Service]
Type=simple
User=atrium
Group=atrium
EnvironmentFile=/etc/atrium/atrium.env
Environment=PYTHONPATH=/opt/atrium/current/backend
WorkingDirectory=/opt/atrium/current/backend
ExecStart=/usr/bin/python3 -m atrium.main
Restart=on-failure
RestartSec=4
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/atrium

[Install]
WantedBy=multi-user.target
